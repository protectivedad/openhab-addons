<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="honeywell"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="oauth20">
		<label>Honeywell API Bridge</label>
		<description>Provides authentication for Honeywell API</description>
		<channels>
			<channel id="connected" typeId="connected"/>
			<channel id="optimized" typeId="optimized"/>
			<channel id="refresh" typeId="refresh"/>
		</channels>
		<properties>
			<property name="vendor">Honeywell</property>
			<property name="thingTypeVersion">1</property>
		</properties>
		<representation-property>consumerKey</representation-property>
		<config-description-ref uri="bridge-type:honeywell"/>
	</bridge-type>

	<channel-type id="connected">
		<item-type>Switch</item-type>
		<label>Connected</label>
		<description>The connection status of the bridge at last refresh</description>
		<category>Network</category>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<channel-type id="optimized">
		<item-type>Switch</item-type>
		<label>Optimized</label>
		<description>Has the refresh been optimized by the bridge</description>
		<category>Switch</category>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<channel-type id="refresh">
		<item-type>Number:Time</item-type>
		<label>Refresh Time</label>
		<description>The bridges current refresh time</description>
		<category>Time</category>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<bridge-type id="thermostat">
		<supported-bridge-type-refs>
			<bridge-type-ref id="oauth20"/>
		</supported-bridge-type-refs>
		<label>Honeywell Thermostat</label>
		<description>Thermostat information, settings, and sensor bridge</description>
		<channel-groups>
			<channel-group id="measurements" typeId="measurements"/>
			<channel-group id="settings" typeId="settings"/>
		</channel-groups>
		<properties>
			<property name="vendor">Honeywell</property>
			<property name="thingTypeVersion">1</property>
		</properties>
		<representation-property>deviceId</representation-property>
		<config-description-ref uri="bridge-type:honeywell:bridge-config-termostat"/>
	</bridge-type>

	<channel-group-type id="measurements">
		<label>Measurement Details</label>
		<description>Measurements from the thermostat and forecast</description>
		<channels>
			<channel id="outtemperature" typeId="system.outdoor-temperature"/>
			<channel id="outhumidity" typeId="system.atmospheric-humidity"/>
			<channel id="temperature" typeId="system.indoor-temperature"/>
			<channel id="humidity" typeId="humidity"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="settings">
		<label>Settings</label>
		<description>Changeable thermostat settings</description>
		<channels>
			<channel id="mode" typeId="mode"/>
			<channel id="schedulestatus" typeId="schedulestatus"/>
			<channel id="setpointstatus" typeId="setpointstatus"/>
			<channel id="nextperiodtime" typeId="nextperiodtime"/>
			<channel id="heatsetpoint" typeId="heatsetpoint"/>
			<channel id="coolsetpoint" typeId="coolsetpoint"/>
		</channels>
	</channel-group-type>

	<channel-type id="schedulestatus">
		<item-type>String</item-type>
		<label>Schedule Status</label>
		<description>Schedule's current status (On/Off)</description>
		<category>Heating</category>
		<tags>
			<tag>Control</tag>
			<tag>None</tag>
		</tags>
		<state>
			<options>
				<option value="Resume">On</option>
				<option value="Pause">Off</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="mode">
		<item-type>String</item-type>
		<label>Thermostat Mode</label>
		<description>Current thermostat operating mode</description>
		<category>Heating</category>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>

	<channel-type id="setpointstatus">
		<item-type>String</item-type>
		<label>Setpoint Status</label>
		<description>Current thermostat setpoint status</description>
		<category>Heating</category>
		<tags>
			<tag>Control</tag>
			<tag>Duration</tag>
		</tags>
	</channel-type>

	<channel-type id="nextperiodtime">
		<item-type>DateTime</item-type>
		<label>Next Period Time</label>
		<description>The time at which regular schedule resumes</description>
		<category>Time</category>
		<tags>
			<tag>Control</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="false" pattern="%1$tH:%1$tM"></state>
	</channel-type>

	<channel-type id="heatsetpoint">
		<item-type>Number:Temperature</item-type>
		<label>Heat Setpoint</label>
		<description>Heating temperature setpoint</description>
		<category>Temperature_hot</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state pattern="%.1f %unit%" step="0.5" readOnly="false"></state>
	</channel-type>

	<channel-type id="coolsetpoint">
		<item-type>Number:Temperature</item-type>
		<label>Cool Setpoint</label>
		<description>Cooling temperature setpoint</description>
		<category>Temperature_cold</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state pattern="%.1f %unit%" step="0.5" readOnly="false"></state>
	</channel-type>

	<thing-type id="sensor">
		<supported-bridge-type-refs>
			<bridge-type-ref id="thermostat"/>
		</supported-bridge-type-refs>
		<label>Honeywell Sensor</label>
		<description>Indoor sensor information</description>
		<channel-groups>
			<channel-group id="readings" typeId="readings"/>
			<channel-group id="sensor" typeId="sensor"/>
			<channel-group id="connection" typeId="connection"/>
		</channel-groups>
		<properties>
			<property name="vendor">Honeywell</property>
			<property name="thingTypeVersion">1</property>
		</properties>
		<representation-property>sensorId</representation-property>
		<config-description-ref uri="thing-type:honeywell:thing-config-sensor"/>
	</thing-type>

	<channel-group-type id="readings">
		<label>Readings</label>
		<description>Measurements from the indoor sensor/thermostat</description>
		<channels>
			<channel id="temperature" typeId="system.indoor-temperature"/>
			<channel id="humidity" typeId="humidity"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="sensor">
		<label>Sensor Details</label>
		<description>Items that are specific to an indoor sensor</description>
		<channels>
			<channel id="motion" typeId="system.motion"/>
			<channel id="exclude" typeId="exclude"/>
			<channel id="occupancy" typeId="occupancy"/>
			<channel id="sensitivity" typeId="sensitivity"/>
			<channel id="batterystatus" typeId="system.low-battery"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="connection">
		<label>Connection Information</label>
		<description>Details that relate to the radio/wireless connection</description>
		<channels>
			<channel id="rssiaverage" typeId="system.signal-strength"/>
			<channel id="status" typeId="status"/>
		</channels>
	</channel-group-type>

	<channel-type id="humidity">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>Indoor Humidity</label>
		<description>Humidity reading at the accessory</description>
		<category>Humidity</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Humidity</tag>
		</tags>
		<state pattern="%.0f %" readOnly="true"></state>
	</channel-type>

	<channel-type id="exclude">
		<item-type>Switch</item-type>
		<label>Exclude Motion</label>
		<description>Used by Active Rooms</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<channel-type id="sensitivity">
		<item-type>String</item-type>
		<label>Motion Sensitivity</label>
		<description>Sensor's sensitivity to motion (Low/Medium/High)</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="Low">Low</option>
				<option value="Medium">Medium</option>
				<option value="High">High</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="occupancy">
		<item-type>Switch</item-type>
		<label>Occupancy</label>
		<description>Is the room occupied?</description>
		<category>Presence</category>
		<tags>
			<tag>Status</tag>
			<tag>Presence</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<channel-type id="status">
		<item-type>Switch</item-type>
		<label>Connection</label>
		<description>Is accesory connected?</description>
		<category>Network</category>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>
</thing:thing-descriptions>
